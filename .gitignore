# ---------------------------------------------------------------------------
# Whitelist policy: everything is ignored by default, and only source code is
# explicitly re-included below. This keeps datasets, model weights, experiment
# outputs and manuscript material out of the repository by construction.
# ---------------------------------------------------------------------------
/*
!/.gitignore
!/LICENSE
!/README.md
!/azureml_submit_runs.py
!/azureml_stop_runs.py

# --- docker setup (from the upstream ePillID benchmark) --------------------
!/docker/
!/docker/**

# --- source tree ------------------------------------------------------------
!/src/
/src/*
!/src/*.py
!/src/*.sh
!/src/models/
!/src/models/**
!/src/configs/
!/src/configs/**
!/src/azureml/
!/src/azureml/**

# internal progress-report generator (writes a Vietnamese status document)
/src/gen_baocao.py

# --- never commit, wherever they appear -------------------------------------
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store
Thumbs.db
.idea/
.vscode/

# datasets, crops and derived data
*.csv
*.jsonl
*.pickle
*.tab

# model weights and adapters
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.traineddata

# experiment outputs and logs
*.log
*.out

# manuscript material (kept out of the repo; the article itself is on the publisher site)
*.tex
*.pdf
*.docx
*.bib
*.cls
*.bst
*.zip

# ---------------------------------------------------------------------------
# Experiment results and run logs.
# Added after the article was published (CMC, DOI 10.32604/cmc.2026.087689).
# These rules come last so they override the blanket *.csv / *.log / *.jsonl
# patterns above.
# ---------------------------------------------------------------------------
!/src/*.log
!/src/fusion_out/
!/src/fusion_out/**
!/src/imprint_ft_data_7525/
!/src/imprint_ft_data_7525/**
!/src/feas7525_base/
!/src/feas7525_base/**
!/src/feas7525_ft/
!/src/feas7525_ft/**
!/src/feas_tesseract/
!/src/feas_tesseract/**
!/src/feasibility_out/
!/src/feasibility_out/**
!/src/feasibility_out_7525/
!/src/feasibility_out_7525/**
!/src/azureml_logs/
!/src/azureml_logs/**
!/src/figures_7525/
!/src/figures_7525/**

# still too large, or superseded by the 75/25 configuration of record
/src/fusion_out/r152_fold3_predictions.csv
/src/fusion_out/_9010_backup/
/src/feasibility_out/_ogyei_s.png
/src/feasibility_out/_ogyei_u.png
